datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum UserRole {
  PLATFORM_ADMIN
  SELLER_OWNER
  SELLER_STAFF
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum StoreStatus {
  DRAFT
  PRIVATE_PREVIEW
  LIVE
  SUSPENDED
  ARCHIVED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  EXPIRED
}

enum ProductMode {
  SELL_ONLINE
  ENQUIRY_ONLY
  SELL_AND_ENQUIRY
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum OptionType {
  COLOUR
  SIZE
  MATERIAL
  STORAGE
  PACK_SIZE
  CUSTOM
}

enum InventoryMovementType {
  INITIAL_STOCK
  MANUAL_ADJUSTMENT
  ORDER_RESERVATION
  ORDER_FULFILLMENT
  ORDER_CANCELLATION
  RETURN_RESTOCK
}

enum OrderStatus {
  NEW
  ACCEPTED
  READY
  DISPATCHED
  COMPLETED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ShipmentStatus {
  PENDING
  MANIFESTED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RTO
}

enum EnquiryStatus {
  NEW
  IN_REVIEW
  QUOTATION_SENT
  ACCEPTED
  REJECTED
  CLOSED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ConsentPurpose {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING_COMMUNICATION
  ORDER_TRACKING
}

enum DataSubjectRequestType {
  DATA_EXPORT
  DATA_ERASURE
  CONSENT_WITHDRAWAL
  DATA_RECTIFICATION
}

enum DataSubjectRequestStatus {
  PENDING
  IN_REVIEW
  FULFILLED
  REJECTED
}

enum PaymentProviderType {
  MOCK
  RAZORPAY
}

enum PaymentPurpose {
  PLATFORM_SUBSCRIPTION
  MERCHANT_ORDER
}

enum ShippingProviderType {
  MOCK
  SHIPROCKET
}

// ==============================================================================
// AUTH & TENANCY
// ==============================================================================

model User {
  id             String             @id @default(uuid())
  phone          String             @unique
  email          String?            @unique
  fullName       String
  role           UserRole           @default(SELLER_OWNER)
  isSuperAdmin   Boolean            @default(false)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")

  memberships    TenantMembership[]
  sessions       Session[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

model OtpRequest {
  id          String    @id @default(uuid())
  phone       String
  codeHash    String    @map("code_hash")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  isVerified  Boolean   @default(false) @map("is_verified")
  expiresAt   DateTime  @map("expires_at")
  verifiedAt  DateTime? @map("verified_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([phone, isVerified, expiresAt])
  @@map("otp_requests")
}

model Session {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  tenantId   String?        @map("tenant_id")
  storeId    String?        @map("store_id")
  tokenHash  String         @unique @map("token_hash")
  ipAddress  String?        @map("ip_address")
  userAgent  String?        @map("user_agent")
  isRevoked  Boolean        @default(false) @map("is_revoked")
  expiresAt  DateTime       @map("expires_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, isRevoked, expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  sessionId         String    @map("session_id")
  tokenHash         String    @unique @map("token_hash")
  deviceName        String?   @map("device_name")
  ipAddress         String?   @map("ip_address")
  isRevoked         Boolean   @default(false) @map("is_revoked")
  expiresAt         DateTime  @map("expires_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tokenHash, isRevoked])
  @@map("refresh_tokens")
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  memberships           TenantMembership[]
  stores                Store[]
  subscriptions         Subscription[]
  invoices              SubscriptionInvoice[]
  paymentAccounts       MerchantPaymentAccount[]
  shippingAccounts      MerchantShippingAccount[]
  shippingProfiles      ShippingProfile[]
  categories            Category[]
  products              Product[]
  customers             Customer[]
  orders                Order[]
  enquiries             Enquiry[]
  auditLogs             AuditLog[]
  dataSubjectRequests   DataSubjectRequest[]

  @@map("tenants")
}

model TenantMembership {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  role      UserRole @default(SELLER_STAFF)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("tenant_memberships")
}

model Store {
  id                   String      @id @default(uuid())
  tenantId             String      @map("tenant_id")
  name                 String
  slug                 String      @unique
  description          String?
  status               StoreStatus @default(DRAFT)
  defaultCurrency      String      @default("INR") @map("default_currency")
  timezone             String      @default("Asia/Kolkata")
  isPubliclyAccessible Boolean     @default(false) @map("is_publicly_accessible")
  previewSecret        String      @default(uuid()) @map("preview_secret")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  deletedAt            DateTime?   @map("deleted_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branding         StoreBranding?
  themeConfigs     StoreThemeConfig[]
  sections         StoreSection[]
  categories       Category[]
  products         Product[]
  customers        Customer[]
  carts            Cart[]
  orders           Order[]
  enquiries        Enquiry[]
  shippingProfiles ShippingProfile[]

  @@index([tenantId, status])
  @@index([slug, isPubliclyAccessible])
  @@map("stores")
}

model StoreBranding {
  id           String   @id @default(uuid())
  storeId      String   @unique @map("store_id")
  logoUrl      String?  @map("logo_url")
  faviconUrl   String?  @map("favicon_url")
  primaryColor String   @default("#1E40AF") @map("primary_color")
  accentColor  String   @default("#F59E0B") @map("accent_color")
  fontHeading  String   @default("Inter") @map("font_heading")
  fontBody     String   @default("Inter") @map("font_body")
  announcement String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_branding")
}

model Theme {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  isDefault   Boolean  @default(false) @map("is_default")
  configJson  Json?    @map("config_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  storeConfigs StoreThemeConfig[]

  @@map("themes")
}

model StoreThemeConfig {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  themeId    String   @map("theme_id")
  configJson Json     @map("config_json")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([storeId, themeId])
  @@map("store_theme_configs")
}

model StoreSection {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  sectionType String   @map("section_type") // hero, featured_products, banner, rich_text, faq
  title       String?
  sortOrder   Int      @default(0) @map("sort_order")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  configJson  Json?    @map("config_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, sortOrder])
  @@map("store_sections")
}

// ==============================================================================
// SUBSCRIPTION SYSTEM
// ==============================================================================

model Plan {
  id                   String   @id @default(uuid())
  code                 String   @unique
  name                 String
  description          String?
  pricePaise           Int      @map("price_paise") // 0 for free/trial, e.g. 99900 for ₹999
  billingCycle         String   @default("MONTHLY") @map("billing_cycle") // MONTHLY, YEARLY
  maxProducts          Int      @default(50) @map("max_products")
  maxStaff             Int      @default(2) @map("max_staff")
  maxStorageMb         Int      @default(1024) @map("max_storage_mb")
  customDomainAllowed  Boolean  @default(false) @map("custom_domain_allowed")
  isPublic             Boolean  @default(true) @map("is_public")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @map("tenant_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  events   SubscriptionEvent[]
  invoices SubscriptionInvoice[]

  @@index([tenantId, status])
  @@map("subscriptions")
}

model SubscriptionEvent {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  eventType      String   @map("event_type") // ACTIVATED, RENEWED, EXPIRED, CANCELLED, OVERRIDDEN
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("subscription_events")
}

model SubscriptionInvoice {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  subscriptionId String    @map("subscription_id")
  invoiceNumber  String    @unique @map("invoice_number")
  amountPaise    Int       @map("amount_paise")
  currency       String    @default("INR")
  status         String    @default("PAID") // PAID, PENDING, VOID
  invoicePdfUrl  String?   @map("invoice_pdf_url")
  paidAt         DateTime? @map("paid_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments     SubscriptionPayment[]

  @@map("subscription_invoices")
}

model SubscriptionPayment {
  id                String   @id @default(uuid())
  invoiceId         String   @map("invoice_id")
  paymentMethod     String   @default("RAZORPAY") @map("payment_method")
  providerPaymentId String?  @map("provider_payment_id")
  amountPaise       Int      @map("amount_paise")
  status            String   @default("SUCCESS")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")

  invoice SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("subscription_payments")
}

// ==============================================================================
// CATALOGUE & VARIANTS
// ==============================================================================

model Category {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  storeId     String   @map("store_id")
  name        String
  slug        String
  description String?
  parentId    String?  @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([storeId, slug])
  @@index([tenantId, storeId, isActive])
  @@map("categories")
}

model Product {
  id               String        @id @default(uuid())
  tenantId         String        @map("tenant_id")
  storeId          String        @map("store_id")
  categoryId       String?       @map("category_id")
  name             String
  slug             String
  description      String?
  mode             ProductMode   @default(SELL_ONLINE)
  status           ProductStatus @default(DRAFT)
  minOrderQuantity Int           @default(1) @map("min_order_quantity")
  leadTimeDays     Int?          @map("lead_time_days")
  brochureUrl      String?       @map("brochure_url")
  specifications   Json?         // Key-value specifications for B2B/industrial products
  enquiryCtaText   String?       @default("Request Quotation") @map("enquiry_cta_text")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category  Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  options   ProductOption[]
  variants  ProductVariant[]
  media     ProductMedia[]
  enquiries Enquiry[]

  @@unique([storeId, slug])
  @@index([tenantId, storeId, status])
  @@index([name])
  @@map("products")
}

model ProductOption {
  id        String     @id @default(uuid())
  tenantId  String     @map("tenant_id")
  storeId   String     @map("store_id")
  productId String     @map("product_id")
  name      String     // e.g. Colour, Size, Material
  type      OptionType @default(CUSTOM)
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@index([tenantId, storeId])
  @@map("product_options")
}

model ProductOptionValue {
  id        String   @id @default(uuid())
  optionId  String   @map("option_id")
  value     String   // e.g. "Navy Blue", "XL", "Cotton"
  colorHex  String?  @map("color_hex") // e.g. #000080
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  option        ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantValues ProductVariantOptionValue[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

model ProductVariant {
  id                  String        @id @default(uuid())
  tenantId            String        @map("tenant_id")
  storeId             String        @map("store_id")
  productId           String        @map("product_id")
  sku                 String
  barcode             String?
  pricePaise          Int           @map("price_paise") // minor units e.g. 129900
  compareAtPricePaise Int?          @map("compare_at_price_paise")
  costPricePaise      Int?          @map("cost_price_paise")
  status              VariantStatus @default(ACTIVE)
  sortOrder           Int           @default(0) @map("sort_order")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")

  product      Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues ProductVariantOptionValue[]
  inventory    Inventory?
  media        ProductMedia[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@unique([storeId, sku])
  @@index([tenantId, storeId, status])
  @@index([sku])
  @@map("product_variants")
}

model ProductVariantOptionValue {
  id            String @id @default(uuid())
  variantId     String @map("variant_id")
  optionValueId String @map("option_value_id")

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId])
  @@map("product_variant_option_values")
}

model ProductMedia {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  storeId    String   @map("store_id")
  productId  String   @map("product_id")
  variantId  String?  @map("variant_id") // Links variant-specific or colour-specific images
  storageKey String   @map("storage_key")
  publicUrl  String   @map("public_url")
  filePath   String   @map("file_path")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  width      Int?
  height     Int?
  altText    String?  @map("alt_text")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([variantId])
  @@map("product_media")
}

// ==============================================================================
// INVENTORY & MOVEMENTS
// ==============================================================================

model Inventory {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  storeId               String   @map("store_id")
  variantId             String   @unique @map("variant_id")
  stockOnHand           Int      @default(0) @map("stock_on_hand")
  stockReserved         Int      @default(0) @map("stock_reserved")
  safetyStockThreshold  Int      @default(0) @map("safety_stock_threshold")
  allowBackorder        Boolean  @default(false) @map("allow_backorder")
  updatedAt             DateTime @updatedAt @map("updated_at")

  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@index([tenantId, storeId])
  @@map("inventory")
}

model InventoryMovement {
  id            String                @id @default(uuid())
  tenantId      String                @map("tenant_id")
  storeId       String                @map("store_id")
  variantId     String                @map("variant_id")
  inventoryId   String                @map("inventory_id")
  movementType  InventoryMovementType @map("movement_type")
  quantityDelta Int                   @map("quantity_delta") // positive for additions, negative for deductions
  balanceAfter  Int                   @map("balance_after")
  referenceType String?               @map("reference_type") // ORDER, MANUAL, RETURN
  referenceId   String?               @map("reference_id")
  notes         String?
  actorId       String?               @map("actor_id")
  createdAt     DateTime              @default(now()) @map("created_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@index([tenantId, storeId])
  @@map("inventory_movements")
}

// ==============================================================================
// CUSTOMERS & GUEST CHECKOUT
// ==============================================================================

model Customer {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  storeId   String   @map("store_id")
  phone     String
  email     String?
  fullName  String   @map("full_name")
  isGuest   Boolean  @default(true) @map("is_guest")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  orders    Order[]
  carts     Cart[]
  consents  ConsentRecord[]

  @@index([tenantId, storeId, phone])
  @@map("customers")
}

model CustomerAddress {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  landmark     String?
  city         String
  state        String
  pincode      String
  country      String   @default("India")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

// ==============================================================================
// CART (GUEST-FIRST)
// ==============================================================================

model Cart {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  storeId    String    @map("store_id")
  guestToken String?   @unique @map("guest_token")
  customerId String?   @map("customer_id")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@index([tenantId, storeId])
  @@index([guestToken])
  @@map("carts")
}

model CartItem {
  id             String   @id @default(uuid())
  cartId         String   @map("cart_id")
  variantId      String   @map("variant_id")
  quantity       Int      @default(1)
  unitPricePaise Int      @map("unit_price_paise")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ==============================================================================
// ORDERS & FULFILLMENT
// ==============================================================================

model Order {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  storeId         String         @map("store_id")
  customerId      String         @map("customer_id")
  orderNumber     String         @unique @map("order_number")
  status          OrderStatus    @default(NEW)
  paymentStatus   PaymentStatus  @default(PENDING) @map("payment_status")
  shipmentStatus  ShipmentStatus @default(PENDING) @map("shipment_status")
  subtotalPaise   Int            @map("subtotal_paise")
  taxPaise        Int            @default(0) @map("tax_paise")
  shippingPaise   Int            @default(0) @map("shipping_paise")
  discountPaise   Int            @default(0) @map("discount_paise")
  totalPaise      Int            @map("total_paise")
  currency        String         @default("INR")
  notes           String?
  deliveryAddress Json           @map("delivery_address") // Snapshot of address
  guestCheckout   Boolean        @default(true) @map("guest_checkout")
  trackingToken   String?        @unique @map("tracking_token")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  cancelledAt     DateTime?      @map("cancelled_at")

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store         Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  paymentOrders PaymentOrder[]
  shipments     Shipment[]
  refunds       Refund[]

  @@index([tenantId, storeId, status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  variantId       String?  @map("variant_id")
  productName     String   @map("product_name") // Snapshot
  variantTitle    String   @map("variant_title") // Snapshot (e.g. "Navy / XL")
  sku             String   // Snapshot
  selectedOptions Json     @map("selected_options") // Snapshot of options
  quantity        Int
  unitPricePaise  Int      @map("unit_price_paise")
  taxPaise        Int      @default(0) @map("tax_paise")
  totalPaise      Int      @map("total_paise")
  createdAt       DateTime @default(now()) @map("created_at")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid())
  orderId    String       @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  reason     String?
  actorId    String?      @map("actor_id")
  createdAt  DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ==============================================================================
// PAYMENTS & MULTI-MERCHANT GATEWAY
// ==============================================================================

model MerchantPaymentAccount {
  id                      String              @id @default(uuid())
  tenantId                String              @map("tenant_id")
  storeId                 String              @map("store_id")
  provider                PaymentProviderType @default(MOCK)
  isEnabled               Boolean             @default(true) @map("is_enabled")
  connectionStatus        String              @default("NOT_CONNECTED") @map("connection_status") // NOT_CONNECTED, CONNECTED, PENDING_VERIFICATION
  kycStatus               String              @default("NOT_STARTED") @map("kyc_status") // NOT_STARTED, IN_REVIEW, VERIFIED, REJECTED
  keyId                   String              @map("key_id") // Merchant-specific API Key ID
  keySecretEncrypted      String              @map("key_secret_encrypted")
  webhookSecretEncrypted  String?             @map("webhook_secret_encrypted")
  merchantAccountId       String?             @map("merchant_account_id")
  capabilities            Json?
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@index([tenantId, storeId])
  @@map("merchant_payment_accounts")
}

model PaymentOrder {
  id              String              @id @default(uuid())
  tenantId        String              @map("tenant_id")
  storeId         String              @map("store_id")
  orderId         String?             @map("order_id")
  subscriptionId  String?             @map("subscription_id")
  purpose         PaymentPurpose      @default(MERCHANT_ORDER)
  provider        PaymentProviderType @default(MOCK)
  providerOrderId String              @map("provider_order_id")
  amountPaise     Int                 @map("amount_paise")
  currency        String              @default("INR")
  status          PaymentStatus       @default(PENDING)
  idempotencyKey  String?             @unique @map("idempotency_key")
  receipt         String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  order        Order?               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@index([tenantId, storeId])
  @@index([providerOrderId])
  @@index([subscriptionId])
  @@map("payment_orders")
}

model PaymentTransaction {
  id                String        @id @default(uuid())
  paymentOrderId    String        @map("payment_order_id")
  providerPaymentId String        @unique @map("provider_payment_id")
  providerSignature String?       @map("provider_signature")
  status            PaymentStatus @default(PAID)
  amountPaise       Int           @map("amount_paise")
  feePaise          Int?          @map("fee_paise")
  taxPaise          Int?          @map("tax_paise")
  paymentMethod     String?       @map("payment_method") // upi, card, netbanking
  rawResponse       Json?         @map("raw_response")
  createdAt         DateTime      @default(now()) @map("created_at")

  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  refunds      Refund[]

  @@map("payment_transactions")
}

model Refund {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  storeId              String   @map("store_id")
  orderId              String   @map("order_id")
  paymentTransactionId String   @map("payment_transaction_id")
  providerRefundId     String?  @unique @map("provider_refund_id")
  amountPaise          Int      @map("amount_paise")
  reason               String?
  status               String   @default("PROCESSED")
  createdAt            DateTime @default(now()) @map("created_at")

  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentTransaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)

  @@index([tenantId, storeId])
  @@map("refunds")
}

model PaymentWebhookEvent {
  id          String         @id @default(uuid())
  provider    String
  purpose     PaymentPurpose @default(MERCHANT_ORDER)
  eventId     String         @unique @map("event_id")
  eventType   String         @map("event_type")
  payload     Json
  payloadHash String?        @map("payload_hash")
  status      String         @default("RECEIVED") // RECEIVED, PROCESSED, FAILED, IGNORED
  retryCount  Int            @default(0) @map("retry_count")
  isProcessed Boolean        @default(false) @map("is_processed")
  processedAt DateTime?      @map("processed_at")
  error       String?
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([provider, eventType, isProcessed])
  @@map("payment_webhook_events")
}

// ==============================================================================
// SHIPPING & LOGISTICS (SHIPROCKET)
// ==============================================================================

model MerchantShippingAccount {
  id                 String               @id @default(uuid())
  tenantId           String               @map("tenant_id")
  storeId            String               @map("store_id")
  provider           ShippingProviderType @default(MOCK)
  isEnabled          Boolean              @default(true) @map("is_enabled")
  apiKeyEncrypted    String               @map("api_key_encrypted")
  apiSecretEncrypted String               @map("api_secret_encrypted")
  accountId          String?              @map("account_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@index([tenantId, storeId])
  @@map("merchant_shipping_accounts")
}

model ShippingProfile {
  id                         String   @id @default(uuid())
  tenantId                   String   @map("tenant_id")
  storeId                    String   @map("store_id")
  name                       String
  flatRatePaise              Int      @default(0) @map("flat_rate_paise")
  freeShippingThresholdPaise Int?     @map("free_shipping_threshold_paise")
  isDefault                  Boolean  @default(true) @map("is_default")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([tenantId, storeId])
  @@map("shipping_profiles")
}

model Shipment {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  storeId     String         @map("store_id")
  orderId     String         @map("order_id")
  provider    String         @default("MOCK")
  awbNumber   String?        @unique @map("awb_number")
  courierName String?        @map("courier_name")
  trackingUrl String?        @map("tracking_url")
  status      ShipmentStatus @default(PENDING)
  labelUrl    String?        @map("label_url")
  manifestUrl String?        @map("manifest_url")
  weightKg    Float?         @map("weight_kg")
  lengthCm    Float?         @map("length_cm")
  widthCm     Float?         @map("width_cm")
  heightCm    Float?         @map("height_cm")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events ShipmentEvent[]

  @@index([tenantId, storeId, status])
  @@map("shipments")
}

model ShipmentEvent {
  id             String    @id @default(uuid())
  shipmentId     String    @map("shipment_id")
  status         String
  location       String?
  description    String?
  eventTimestamp DateTime? @map("event_timestamp")
  createdAt      DateTime  @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt])
  @@map("shipment_events")
}

// ==============================================================================
// B2B & ENQUIRIES
// ==============================================================================

model Enquiry {
  id                   String        @id @default(uuid())
  tenantId             String        @map("tenant_id")
  storeId              String        @map("store_id")
  productId            String?       @map("product_id")
  customerName         String        @map("customer_name")
  customerPhone        String        @map("customer_phone")
  customerEmail        String?       @map("customer_email")
  companyName          String?       @map("company_name")
  message              String
  requestedQuantity    Int           @default(1) @map("requested_quantity")
  status               EnquiryStatus @default(NEW)
  quotationAmountPaise Int?          @map("quotation_amount_paise")
  notes                String?
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId, storeId, status])
  @@map("enquiries")
}

// ==============================================================================
// AUDIT, OUTBOX & RELIABILITY
// ==============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actorType  String   @default("USER") @map("actor_type") // USER, SYSTEM, ADMIN
  tenantId   String?  @map("tenant_id")
  storeId    String?  @map("store_id")
  action     String   // e.g. STORE_SUSPENDED, PRODUCT_CREATED, REFUND_ISSUED
  entityType String   @map("entity_type") // Store, Product, Order, etc.
  entityId   String?  @map("entity_id")
  metadata   Json?    // Safe metadata (strictly no secrets/passwords)
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  id                 String            @id @default(uuid())
  key                String            @unique
  tenantId           String?           @map("tenant_id")
  storeId            String?           @map("store_id")
  route              String
  requestHash        String            @map("request_hash")
  status             IdempotencyStatus @default(IN_PROGRESS)
  responseStatusCode Int?              @map("response_status_code")
  responseBody       Json?             @map("response_body")
  expiresAt          DateTime          @map("expires_at")
  createdAt          DateTime          @default(now()) @map("created_at")

  @@index([key, status, expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id          String       @id @default(uuid())
  tenantId    String?      @map("tenant_id")
  storeId     String?      @map("store_id")
  eventType   String       @map("event_type")
  payload     Json
  status      OutboxStatus @default(PENDING)
  retryCount  Int          @default(0) @map("retry_count")
  maxRetries  Int          @default(5) @map("max_retries")
  lastError   String?      @map("last_error")
  nextRetryAt DateTime?    @map("next_retry_at")
  processedAt DateTime?    @map("processed_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([status, nextRetryAt])
  @@map("outbox_events")
}

// ==============================================================================
// PRIVACY & DPDPA CONTROLS
// ==============================================================================

model ConsentRecord {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  storeId       String         @map("store_id")
  customerId    String?        @map("customer_id")
  phone         String
  purpose       ConsentPurpose
  policyVersion String         @default("v1.0") @map("policy_version")
  ipAddress     String?        @map("ip_address")
  userAgent     String?        @map("user_agent")
  consentedAt   DateTime       @default(now()) @map("consented_at")
  revokedAt     DateTime?      @map("revoked_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, phone, purpose])
  @@map("consent_records")
}

model DataSubjectRequest {
  id          String                   @id @default(uuid())
  tenantId    String                   @map("tenant_id")
  phone       String
  email       String?
  requestType DataSubjectRequestType   @map("request_type")
  status      DataSubjectRequestStatus @default(PENDING)
  reason      String?
  requestedAt DateTime                 @default(now()) @map("requested_at")
  fulfilledAt DateTime?                @map("fulfilled_at")
  metadata    Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("data_subject_requests")
}
