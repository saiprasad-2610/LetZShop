# ==============================================================================
# Simply E-Commerce - Environment Variables Template
# ==============================================================================

# Core Application Settings
NODE_ENV=development
PORT=4000
BRAND_NAME="Simply E-Commerce"
APP_URL=http://localhost:4000
STOREFRONT_BASE_URL=http://localhost:3000
SELLER_DASHBOARD_URL=http://localhost:3001
ADMIN_DASHBOARD_URL=http://localhost:3002

# Database Settings
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/simply_ecommerce?schema=public
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/simply_ecommerce_test?schema=public

# Authentication & Sessions
JWT_ACCESS_SECRET=your-jwt-access-secret-minimum-32-chars-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-minimum-32-chars-long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d
COOKIE_SECRET=your-cookie-signing-secret-minimum-32-chars

# Email OTP: 10-minute expiry, 60-second resend cooldown, five attempts.
# SMS mock provider is available only under NODE_ENV=test.
OTP_DEV_MOCK_ENABLED=false

# Twilio SMS Gateway (Production OTPs)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Media / Object Storage
MEDIA_STORAGE_DRIVER=local # local | r2 | s3
MEDIA_STORAGE_LOCAL_ROOT=./media-storage
MEDIA_PUBLIC_URL_PREFIX=http://localhost:4000/media/file
MEDIA_MAX_FILE_SIZE_BYTES=10485760 # 10MB

# Cloudflare R2 Storage (Required in Production when MEDIA_STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_BUCKET=letzshop-public-media
R2_PRIVATE_BUCKET=letzshop-private-documents
R2_PUBLIC_URL_PREFIX=https://media.letzshop.store # Custom domain or https://pub-<hash>.r2.dev
R2_REGION=auto
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com # Optional explicit endpoint override


# Payment Gateway (Mock vs Razorpay)
PAYMENT_PROVIDER=mock
RAZORPAY_PLATFORM_KEY_ID=
RAZORPAY_PLATFORM_KEY_SECRET=
RAZORPAY_PLATFORM_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Logistics / Shipping (Mock vs Shiprocket)
SHIPPING_PROVIDER=mock
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_TOKEN=
SHIPROCKET_API_TOKEN=

# Rate Limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

