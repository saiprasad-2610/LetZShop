# ==============================================================================
# LETZSHOP PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# Base URLs (Public Frontends and Admin)
STOREFRONT_BASE_URL=http://localhost:3000
SELLER_DASHBOARD_URL=http://localhost:3001
ADMIN_DASHBOARD_URL=http://localhost:3002

# Next.js Public Endpoints (Client-Side)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_SELLER_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# Production CORS Whitelist
# In production, specify comma-separated HTTPS origins. Unlisted origins receive NO CORS headers.
CORS_ALLOWED_ORIGINS=https://letzshop.store,https://www.letzshop.store,https://seller.letzshop.store,https://admin.letzshop.store

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/simply_ecommerce?schema=public

# Redis Connection (Session & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication Secrets (Required in Production - Min 32 chars)
JWT_ACCESS_SECRET=dev-jwt-access-secret-replace-in-production-min-32-chars!
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-replace-in-production-min-32-chars!
COOKIE_SECRET=dev-cookie-secret-change-in-prod-32!

# OTP Dev Mock (MUST be false in Production)
OTP_DEV_MOCK_ENABLED=true
OTP_EXPIRY_MINUTES=5

# Media & Object Storage Driver (local | r2 | s3)
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_LOCAL_ROOT=./media-storage
MEDIA_PUBLIC_URL_PREFIX=http://localhost:4000/media
MEDIA_MAX_FILE_SIZE_BYTES=10485760 # 10MB

# Cloudflare R2 Object Storage (Required in Production when MEDIA_STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_BUCKET=letzshop-public-media
R2_PRIVATE_BUCKET=letzshop-private-documents
R2_PUBLIC_URL_PREFIX=https://media.letzshop.store
R2_REGION=auto
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Payment Gateway (mock | razorpay)
PAYMENT_PROVIDER=mock
# Merchant Storefront Payments (Direct checkout)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Platform Subscriptions & AutoPay (Merchant SaaS Billing)
RAZORPAY_PLATFORM_KEY_ID=your_platform_razorpay_key_id
RAZORPAY_PLATFORM_KEY_SECRET=your_platform_razorpay_key_secret
RAZORPAY_PLATFORM_WEBHOOK_SECRET=your_platform_webhook_secret

# Rate Limiting
CHECKOUT_RATE_LIMIT=20
PAYMENT_RATE_LIMIT=30

# Transactional Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@letzshop.store
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="LetzShop <no-reply@letzshop.store>"

# WhatsApp & SMS (Optional external gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Shipping Integration (Shiprocket)
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
