# ==============================================================================
# Simply E-Commerce - Environment Variables Template
# ==============================================================================

# Core Application Settings
NODE_ENV=development
PORT=4000
BRAND_NAME="Simply E-Commerce"
APP_URL=http://localhost:4000
STOREFRONT_BASE_URL=http://localhost:3000
SELLER_DASHBOARD_URL=http://localhost:3001
ADMIN_DASHBOARD_URL=http://localhost:3002

# Database Settings
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/simply_ecommerce?schema=public
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/simply_ecommerce_test?schema=public

# Authentication & Sessions
JWT_ACCESS_SECRET=your-jwt-access-secret-minimum-32-chars-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-minimum-32-chars-long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d
COOKIE_SECRET=your-cookie-signing-secret-minimum-32-chars

# OTP Settings (Development vs Production)
OTP_DEV_MOCK_ENABLED=false
OTP_DEV_DEFAULT_CODE=123456
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Twilio SMS Gateway (Production OTPs)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Media / Object Storage
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_LOCAL_ROOT=./media-storage
MEDIA_PUBLIC_URL_PREFIX=http://localhost:4000/media
MEDIA_MAX_FILE_SIZE_BYTES=10485760 # 10MB

# Payment Gateway (Mock vs Razorpay)
PAYMENT_PROVIDER=mock
RAZORPAY_PLATFORM_KEY_ID=
RAZORPAY_PLATFORM_KEY_SECRET=
RAZORPAY_PLATFORM_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Logistics / Shipping (Mock vs Shiprocket)
SHIPPING_PROVIDER=mock
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_TOKEN=
SHIPROCKET_API_TOKEN=

# Rate Limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

